# LLM API Settings (OpenAI-compatible: OpenAI, OpenRouter, Groq, LocalAI, etc.)
# Leave blank to use the offline audio-peak + sentence fallback
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Whisper transcription settings (tiny, base, small, medium)
WHISPER_MODEL=tiny

# Clip constraints
MIN_CLIP_SECONDS=20
MAX_CLIP_SECONDS=60

# Video Limits
MAX_VIDEO_MINUTES=30
MAX_FILE_SIZE_MB=1000

# --- Import from link (YouTube / TikTok / Instagram via yt-dlp) ---
# Highest download height. 720 is fast; mp4 (avc1 + m4a) is preferred.
YTDLP_MAX_HEIGHT=720

# How long one link download may take before it is stopped (seconds).
YTDLP_TIMEOUT_SECONDS=1800

# Cookies are OPTIONAL. Only needed when a site asks "confirm you're not a bot".
# Do NOT use cookies from your personal main Google account with
# YTDLP_COOKIES_FROM_BROWSER or YTDLP_COOKIES_FILE: that gives yt-dlp full
# access to the account. If you need cookies, use a separate throwaway account.
# YTDLP_COOKIES_FILE=
# YTDLP_COOKIES_FROM_BROWSER=
