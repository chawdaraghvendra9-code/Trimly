# ============================================================
# Trimly Clip Studio - example settings
# Source/ZIP build: copy this file to .env and edit only what you need.
# Installed command-line build: `trimly setup` writes
#   %APPDATA%\Trimly\config.env instead, with the same names.
# Every value below has a safe default, so an empty file still runs.
# ============================================================

# --- AI highlight suggestions (optional) ---
# An OpenAI-compatible chat endpoint. With a key, the transcript text
# (never the video) is sent to this service to pick better clips.
# Leave LLM_API_KEY empty to use Basic suggestions mode (fully offline).
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Comma-separated fallback list. Reserved for a future release; only
# LLM_MODEL is used by the current highlight pipeline.
# LLM_MODELS=meta-llama/llama-3.3-70b-instruct:free
# Reserved timeout setting. The current LLM request timeout is fixed in code.
LLM_TIMEOUT=60

# --- Speech transcription (local by default, no audio leaves your PC) ---
# tiny = fastest, base = balanced (default), small/medium = more accurate/slower.
WHISPER_MODEL=base
# Only "local" is implemented today (faster-whisper on this computer).
# The three hosted settings below are reserved for a future release.
TRANSCRIPTION_MODE=local
# TRANSCRIPTION_API_BASE=https://api.openai.com/v1
# TRANSCRIPTION_API_KEY=
# TRANSCRIPTION_MODEL=whisper-1

# --- Clip length rules (seconds) ---
MIN_CLIP_SECONDS=20
PREFERRED_MIN_SECONDS=30
PREFERRED_MAX_SECONDS=90
MAX_CLIP_SECONDS=120

# --- Video and upload limits ---
MAX_VIDEO_MINUTES=30
MAX_FILE_SIZE_MB=1000
# Vertical layout used for new jobs: blurred_background (default) or center_crop.
DEFAULT_CROP_STYLE=blurred_background
# Base limit for one ffmpeg render. Long clips automatically get more time.
RENDER_TIMEOUT_SECONDS=300

# --- Import from link ---
# Public releases ship with streaming-site imports OFF. When false, only
# direct video files and public Google Drive / Dropbox links are accepted.
# Set to true to also allow YouTube, TikTok and Instagram (needs Node.js 22+).
ENABLE_YOUTUBE_IMPORT=false
# Highest download height for streaming-site imports (720 keeps files small).
YTDLP_MAX_HEIGHT=720
# How long one link download may take before it is stopped (seconds).
YTDLP_TIMEOUT_SECONDS=1800

# Cookies are OPTIONAL and only needed when a site asks "confirm you're not a bot".
# Do NOT use cookies from your personal main Google account: that gives yt-dlp
# full access to the account. Use a separate throwaway account instead.
# YTDLP_COOKIES_FILE=
# YTDLP_COOKIES_FROM_BROWSER=
