# LLM API Settings (OpenAI-compatible: OpenAI, OpenRouter, Groq, LocalAI, etc.)
# Leave blank to use the offline audio-peak + sentence fallback
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Whisper transcription settings (tiny, base, small, medium)
WHISPER_MODEL=tiny

# Clip constraints
MIN_CLIP_SECONDS=20
MAX_CLIP_SECONDS=60

# Video Limits
MAX_VIDEO_MINUTES=30
MAX_FILE_SIZE_MB=1000
